# Sudojo API Environment Variables
# Copy this file to .env.local and update with your values
# Priority: .env.local > .env > system environment

# =============================================================================
# Database
# =============================================================================
# PostgreSQL connection string
DATABASE_URL=postgres://username:password@localhost:5432/sudojo

# =============================================================================
# Server
# =============================================================================
# Port to run the server on (default: 3000)
PORT=3000

# =============================================================================
# Firebase Admin SDK
# =============================================================================
# Firebase project ID
FIREBASE_PROJECT_ID=

# Firebase service account client email
FIREBASE_CLIENT_EMAIL=

# Firebase service account private key (include the full key with \n for newlines)
FIREBASE_PRIVATE_KEY=

# =============================================================================
# Site Admin Access
# =============================================================================
# Comma-separated list of email addresses for site admin access.
# Site admins bypass subscription/rate limit checks and can access admin features.
# Example: admin@example.com,another@example.com
SITEADMIN_EMAILS=

# =============================================================================
# RevenueCat
# =============================================================================
# RevenueCat secret API key (from RevenueCat dashboard > Project Settings > API Keys)
REVENUECAT_API_KEY=

# =============================================================================
# Solver Service
# =============================================================================
# URL of the Sudoku solver service
SOLVER_URL=http://localhost:5000

# API key for admin access to solver endpoints (bypasses auth and rate limits)
# Generate a secure random string for production
SOLVER_API_KEY=

# Request timeout in milliseconds for solver calls (default: 60000)
SOLVER_TIMEOUT_MS=60000

# =============================================================================
# Apple Sign In (for account deletion token revocation)
# =============================================================================
# Apple Services ID (e.g., com.sudobility.sudojo.web)
APPLE_CLIENT_ID=
# Apple Developer Team ID
APPLE_TEAM_ID=
# Key ID for the Sign in with Apple key
APPLE_KEY_ID=
# The .p8 private key content (include full PEM format)
APPLE_PRIVATE_KEY=

# =============================================================================
# Solution Encryption
# =============================================================================
# AES-256-GCM encryption key for encrypting solution fields (hex-encoded, 64 chars)
# Generate with: openssl rand -hex 32
# Optional - if not set, solution encryption is skipped (passthrough for dev)
SOLUTION_ENCRYPTION_KEY=

# =============================================================================
# Admin API Key
# =============================================================================
# Shared secret accepted in the X-API-Key header (or ?api_key=) on
# GET /solver/solve. A matching request skips Firebase token verification and
# is treated as anonymous. Hint limits are not enforced for anyone, so this no
# longer unlocks anything. Leave empty to disable.
ADMIN_API_KEY=

# =============================================================================
# Legacy Site Admin Alias
# =============================================================================
# Deprecated fallback for SITEADMIN_EMAILS - only consulted when
# SITEADMIN_EMAILS is unset. Prefer SITEADMIN_EMAILS above.
ADMIN_EMAILS=

# =============================================================================
# OCR ML Service (Optional)
# =============================================================================
# URL of the ML-based OCR service. When empty the ML path is skipped entirely
# and the built-in OCR fallback is used.
OCR_ML_URL=

# Request timeout in milliseconds for the OCR ML service (default: 20000)
OCR_ML_TIMEOUT_MS=20000

# =============================================================================
# PaddleOCR Service (Optional)
# =============================================================================
# URL of the paddle_ocr service. When empty the paddle path is disabled:
# camera scans return 503 and library scans use sudojo_ocr_ml alone.
PADDLE_OCR_URL=

# Request timeout in milliseconds for paddle_ocr (default: 30000)
PADDLE_OCR_TIMEOUT_MS=30000

# Used by `bun run test:db`. Must point at localhost; the guard refuses any other host.
TEST_DATABASE_URL=postgresql://localhost:5432/sudojo_test

# Template for .env.test, which is gitignored because the real file holds live
# credentials (a production RevenueCat key, a real Firebase private key, a
# solver key). Copy this to .env.test and fill in real values where needed.
#
# TEST_DATABASE_URL must point at localhost. The guard in tests/setup.db.ts
# refuses any other host, 127.0.0.1 included.

# Server
PORT=3000
# Site admin emails (comma-separated) - bypass subscription checks
SITEADMIN_EMAILS=test@example.com
# Firebase Admin SDK
FIREBASE_PROJECT_ID=test-project
FIREBASE_CLIENT_EMAIL=test@test-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=test-private-key
# RevenueCat. The real .env.test uses a production key; a placeholder is fine
# for any test that does not exercise live subscription lookups.
REVENUECAT_API_KEY=test-revenuecat-key
# Solver Service
SOLVER_URL=http://localhost:8080
SOLVER_API_KEY=test-solver-key
SOLUTION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
TEST_DATABASE_URL=postgresql://localhost:5432/sudojo_test
